@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ThemeService ThemeService



<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <MudThemeProvider />
    <main>

        <MudThemeProvider Theme="@CurrentTheme"
                          IsDarkMode="@ThemeService.IsDarkMode" />

        <MudDialogProvider />
        <MudSnackbarProvider />


     <article class="content px-4">
       @Body
     </article> 
        <MudIconButton Icon="@ThemeIcon"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme" />

        <MudFab StartIcon="@Icons.Material.Filled.Add"
                Class="premium-fab"
                Color="Color.Primary"
                OnClick="GoToAddEntry" 
                Style="
        position: fixed;
        bottom: 90px;
        right: 24px;
        left: auto;
        z-index: 9999;
        " />

       @*  <MudFab Icon="@Icons.Material.Filled.Add"
                Color="Color.Primary"
                Class="fab-button"
                OnClick="GoToAddEntry" />

        <MudFab Icon="@Icons.Material.Filled.Add"
                Color="Color.Primary"
                Size="Size.Large"
                Class="premium-fab"
                OnClick="GoToAddEntry" /> *@

       @*  <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div> *@

      @*   <article class="content px-4">

            @Body
        </article> *@
    </main>
   @*  <MudFab Icon="@Icons.Material.Filled.Add"
            Color="Color.Primary"
            Style="
    position: fixed;
    bottom: 90px;
    right: 24px;
    left: auto;
    z-index: 9999;
    " /> *@
</div>



@code {

    
    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += Refresh;
    }

    private string ThemeIcon =>
      ThemeService.IsDarkMode
          ? Icons.Material.Filled.LightMode
          : Icons.Material.Filled.DarkMode;

    private MudTheme CurrentTheme =>
      ThemeService.IsDarkMode
          ? AppTheme.DarkTheme
          : AppTheme.LightTheme;

    private void GoToAddEntry()
    {
        Navigation.NavigateTo("/add");
    }

    private void ToggleTheme()
    {
        ThemeService.ToggleTheme();
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= Refresh;
    }
}

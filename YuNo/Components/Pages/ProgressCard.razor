@using MudBlazor
@inject StatisticsService StatisticsService
@inject SettingsService Settings

<MudPaper Class="pa-5 rounded-xl mt-2">

    @* <MudText Typo="Typo.h5">
        Прогресс
    </MudText> *@

    <h1>Дневник.нет</h1>

    Добро пожаловать в Ваш Журнал отказов

    Ваша задача - набрать за год @_stats.Goal ответов нет от кого угодно. Будьте смелее, просите скидки, пробуйте новое. Добивайтесь ответов нет!

    <MudText Typo="Typo.h5" Class="mb-3 mt-3">
        Прогресс: @_stats.TotalNoCount / @_stats.Goal НЕТ
    </MudText>
@*     <MudText Class="mt-2 progress-number">
        @_stats.TotalNoCount / @_stats.Goal НЕТ
    </MudText> *@

@*     <MudProgressLinear Value="12.7"
                       Rounded="true"
                       Color="Color.Primary"
                       Striped="true"
                       Style="height:14px;" />
 *@
    <MudProgressLinear Value="@_stats.ProgressPercent"
                       Rounded="true"
                       Color="Color.Primary"
                       Striped="true"
                       Style="height:14px;" />

</MudPaper>

@code {
    private Stat _stats = new();

    protected override async Task OnInitializedAsync()
    {
        Settings.SettingsChanged += Refresh;
        await LoadStats();
    }
    private async Task LoadStats()
    {
        _stats =
            await StatisticsService.GetStatAsync();
    }

    private async void Refresh()
    {
        await LoadStats();

        await InvokeAsync(
            StateHasChanged);
    }

    public void Dispose()
    {
        Settings.SettingsChanged -= Refresh;
    }
}

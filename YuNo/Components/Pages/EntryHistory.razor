@page "/history"
@using MudBlazor

@inject DiaryRepository Repository
@inject ISnackbar Snackbar

<h3>История</h3>

<MudStack Spacing="2" >
    @if (_entries.Count == 0)
    {
        <MudPaper Class="home-card pa-5 rounded-xl">
            <MudText Typo="Typo.h6">
                Пусто
            </MudText>
        </MudPaper>
    }
    else
    {
        foreach (NoEntry entry in _entries)
        {
            <MudPaper Class="home-card pa-5 rounded-xl">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Stretch">
                <div>
                       @*  <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-3">
                    @entry.Title
                </MudText> *@
                  
                <MudText Typo="Typo.h6" >
                            <b>@entry.Title</b>
                </MudText>
               @*  <MudText Typo="Typo.h6">
                    @entry.CreatedAt
                </MudText> *@

                @if (!string.IsNullOrWhiteSpace(entry.Description))
                {
                    <MudText Typo="Typo.h6">
                        @entry.Description
                    </MudText>
                }
                </div>

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="() => Delete(entry.Id)" />

                </MudStack>
                <MudDivider Class="my-3" />

                <MudText Class="entry-date">
                    @entry.CreatedAt.ToString("dd MMM • HH:mm")
                </MudText>
            </MudPaper>
        }
    }
    </MudStack>

@code {

    private List<NoEntry> _entries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        _entries =
            await Repository.GetAllAsync();
    }

    private async Task Delete(int id)
    {
        await Repository.DeleteAsync(id); 

        Snackbar.Add(
            "Запись удалена",
            Severity.Success);

        await LoadEntries();

        StateHasChanged();
    }
}
